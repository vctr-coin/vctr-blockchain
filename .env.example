# Read-only service: no signing key is needed.
RPC_URL=https://sepolia.base.org
CHAIN_ID=84532
ETHEREUM_SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com
TOKEN_ADDRESS=
PROVIDER_ADDRESS=
CONFIRMATIONS=5
PORT=3000
DB_PATH=data/vctr.sqlite
# Testnet deployment only: use a dedicated test-only key.
DEPLOYER_PRIVATE_KEY=
TREASURY_ADDRESS=
TOTAL_SUPPLY=

# Optional RPC override for Base Mainnet (chain ID 8453).
BASE_MAINNET_RPC=https://mainnet.base.org

# Mainnet deployment only: use a separate deployer key funded only for deployment.
# Do not reuse the testnet key or commit/paste a real key. Prefer an approved secret manager.
BASE_MAINNET_DEPLOYER_PRIVATE_KEY=

# Full commit SHA approved after the independent review; the script rejects dirty trees.
BASE_MAINNET_APPROVED_COMMIT=
